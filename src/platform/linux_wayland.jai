// The Wayland window system, for platform_linux.jai: native, in a Wayland
// session (GNOME, KDE Plasma, Sway, Hyprland...), with no XWayland between
// the app and the compositor.
//
// - One xdg_toplevel surface, drawn only by the Vulkan backend
//   (render/vulkan) through VK_KHR_wayland_surface. The surface is mapped by
//   the first frame Vulkan presents, so the window appears with its content
//   and never flashes empty.
// - Sizes are physical pixels like everywhere else; Wayland's own are
//   logical (surface coordinates). The scale is the compositor's: fractional
//   (wp_fractional_scale_v1, 1.25, 1.5...) with the buffer drawn at exactly
//   that size and shown at the logical one through wp_viewport, so text is
//   as sharp at 125% as at 100%; else the integer buffer scale.
// - The compositor draws the title bar when it offers to
//   (zxdg_decoration_manager_v1: KDE, Sway, Hyprland...). When it doesn't
//   (GNOME, Weston), platform.client_decorations is set and the app draws the
//   window controls in its own header; the window's edges resize it, here.
// - Keyboards come as XKB keymaps (libxkbcommon), keys repeat by our own
//   timer (Wayland doesn't repeat them), and dead keys and Compose go through
//   xkbcommon's compose tables.
// - The main loop sleeps in poll() on the Wayland socket and the eventfd,
//   with libwayland's prepare_read protocol, since Vulkan reads the same
//   socket for its own event queue.
//
// libwayland-client, libwayland-cursor and libxkbcommon are loaded at run
// time; when they or a compositor aren't there, platform_init falls back to
// X11. The protocols beyond the core one are declared here (define_protocols)
// rather than generated by wayland-scanner.

// For the Vulkan backend: the wl_display and the wl_surface, as Vulkan's
// Wayland surface takes them.
platform_wayland_display: *void;
platform_wayland_surface: *void;

wayland_init :: (title: string, logical_width: int, logical_height: int) -> bool {
    if !dl_load(*wl, .["libwayland-client.so.0"]) || !dl_load(*xkb, .["libxkbcommon.so.0"]) {
        log("Wayland: libwayland-client or libxkbcommon is missing.\n");
        return false;
    }
    if !load_core_interfaces() return false;
    display = wl.wl_display_connect(null);
    if !display {
        log("Wayland: could not connect to the compositor (WAYLAND_DISPLAY is \"%\").\n", to_string(POSIX.getenv("WAYLAND_DISPLAY")));
        return false;
    }
    define_protocols();
    xkb_context = xkb.xkb_context_new(0);

    registry = create(display, WL_DISPLAY_GET_REGISTRY, core.wl_registry_interface, 1);
    wl.wl_proxy_add_listener(registry, *registry_listener, null);
    wl.wl_display_roundtrip(display);   // The globals.
    if !compositor || !wm_base {
        log("Wayland: the compositor has no % (xdg-shell).\n", ifx compositor then "xdg_wm_base" else "wl_compositor");
        return false;
    }
    wl.wl_display_roundtrip(display);   // What the globals said when bound: the seat's devices, the outputs' modes.

    surface = create(compositor, WL_COMPOSITOR_CREATE_SURFACE, core.wl_surface_interface, version(compositor));
    wl.wl_proxy_add_listener(surface, *surface_listener, null);
    if fractional_scale_manager && viewporter {
        fractional_scale = create(fractional_scale_manager, WP_FRACTIONAL_SCALE_MANAGER_GET_FRACTIONAL_SCALE, *wp_fractional_scale_v1_interface, 1, 0, address(surface));
        wl.wl_proxy_add_listener(fractional_scale, *fractional_scale_listener, null);
        viewport = create(viewporter, WP_VIEWPORTER_GET_VIEWPORT, *wp_viewport_interface, 1, 0, address(surface));
    }
    xdg_surface = create(wm_base, XDG_WM_BASE_GET_XDG_SURFACE, *xdg_surface_interface, version(wm_base), 0, address(surface));
    wl.wl_proxy_add_listener(xdg_surface, *xdg_surface_listener, null);
    toplevel = create(xdg_surface, XDG_SURFACE_GET_TOPLEVEL, *xdg_toplevel_interface, version(wm_base));
    wl.wl_proxy_add_listener(toplevel, *toplevel_listener, null);
    wayland_set_title(title);
    // The desktop entry's name: docks and task switchers find the icon by it.
    send(toplevel, XDG_TOPLEVEL_SET_APP_ID, address(temp_c_string(APP_ID)));
    send(toplevel, XDG_TOPLEVEL_SET_MIN_SIZE, MIN_WINDOW_WIDTH, MIN_WINDOW_HEIGHT);

    // A title bar from the compositor if it draws them; else ours.
    platform.client_decorations = true;
    if decoration_manager {
        decoration = create(decoration_manager, ZXDG_DECORATION_MANAGER_GET_TOPLEVEL_DECORATION, *zxdg_toplevel_decoration_v1_interface, 1, 0, address(toplevel));
        wl.wl_proxy_add_listener(decoration, *decoration_listener, null);
        send(decoration, ZXDG_TOPLEVEL_DECORATION_SET_MODE, ZXDG_TOPLEVEL_DECORATION_MODE_SERVER_SIDE);
    }

    logical.width, logical.height = xx logical_width, xx logical_height;
    send(surface, WL_SURFACE_COMMIT);   // No buffer yet: asks for the first configure.
    for 1..10 {
        if configured break;
        if wl.wl_display_roundtrip(display) < 0 break;
    }
    if !configured {
        log("Wayland: the compositor never configured the window.\n");
        return false;
    }

    platform_wayland_display = display;
    platform_wayland_surface = surface;
    platform.double_click_seconds = 0.4;   // GTK's and Qt's default; Wayland doesn't say.
    log("Wayland: % (scale %, %)\n", to_string(POSIX.getenv("XDG_CURRENT_DESKTOP")), platform.dpi_scale,
        ifx platform.client_decorations then "title bar drawn by Uppies" else "title bar drawn by the compositor");
    return true;
}

// The window maps with the first frame Vulkan presents; here it only asks
// for the focus a launcher's activation token grants.
wayland_show_window :: () {
    token := to_string(POSIX.getenv("XDG_ACTIVATION_TOKEN"));
    if token && activation {
        send(activation, XDG_ACTIVATION_ACTIVATE, address(temp_c_string(token)), address(surface));
        POSIX.unsetenv("XDG_ACTIVATION_TOKEN");   // Children (xdg-open) mustn't reuse it.
        wl.wl_display_flush(display);
    }
}

wayland_shutdown :: () {
    if !display return;
    if clipboard.source destroy(clipboard.source, WL_DATA_SOURCE_DESTROY);
    if decoration       destroy(decoration, ZXDG_TOPLEVEL_DECORATION_DESTROY);
    if toplevel         destroy(toplevel, XDG_TOPLEVEL_DESTROY);
    if xdg_surface      destroy(xdg_surface, XDG_SURFACE_DESTROY);
    if viewport         destroy(viewport, WP_VIEWPORT_DESTROY);
    if fractional_scale destroy(fractional_scale, WP_FRACTIONAL_SCALE_DESTROY);
    if cursor_surface   destroy(cursor_surface, WL_SURFACE_DESTROY);
    if surface          destroy(surface, WL_SURFACE_DESTROY);
    if cursor_theme     wl_cursor.wl_cursor_theme_destroy(cursor_theme);
    wl.wl_display_flush(display);
    wl.wl_display_disconnect(display);
    display = null;
    platform_wayland_display, platform_wayland_surface = null, null;
}

// Handles every pending event without blocking.
wayland_pump_events :: () {
    dispatch(0);
    repeat_keys();
}

// Sleeps until the compositor has an event for us, or until timeout_seconds
// pass (negative: no timeout), or a held key is due to repeat.
wayland_wait_for_events :: (timeout_seconds: float64 = -1) {
    timeout := timeout_seconds;
    if keyboard.repeat_key {
        until := max(keyboard.repeat_next - seconds_since_init(), 0);
        timeout = ifx timeout < 0 then until else min(timeout, until);
    }
    dispatch(linux_poll_timeout(timeout));
    repeat_keys();
}

wayland_clipboard_get :: () -> string {   // Temporary storage.
    if !display return "";
    if clipboard.source return copy_string(clipboard.text,, temp);   // Ours: asking ourselves would wait on ourselves.
    offer := clipboard.selection;
    if !offer || !offer.mime return "";

    fds: [2] s32;
    if POSIX.pipe2(*fds, POSIX.O_CLOEXEC) != 0 return "";
    send(offer.proxy, WL_DATA_OFFER_RECEIVE, address(temp_c_string(offer.mime)), cast(u64) fds[1]);
    POSIX.close(fds[1]);   // Our copy: the reading end sees the end when the owner closes its own.
    wl.wl_display_flush(display);
    defer POSIX.close(fds[0]);

    builder: String_Builder;
    builder.allocator = temp;
    buffer: [4096] u8;
    deadline := seconds_since_init() + 1;
    while true {
        remaining := deadline - seconds_since_init();
        if remaining <= 0 { log_error("The clipboard's owner didn't answer.\n"); return ""; }
        pollfd := POSIX.pollfd.{fd = fds[0], events = POSIX.POLLIN};
        if POSIX.poll(*pollfd, 1, cast(s32) (remaining * 1000) + 1) <= 0 continue;
        n := POSIX.read(fds[0], buffer.data, buffer.count);
        if n < 0 && POSIX.errno() == POSIX.EINTR continue;
        if n <= 0 break;
        append(*builder, buffer.data, n);
    }
    return builder_to_string(*builder,, temp);
}

wayland_clipboard_set :: (text: string) {
    if !display || !data_device return;
    if clipboard.source destroy(clipboard.source, WL_DATA_SOURCE_DESTROY);
    free(clipboard.text);
    clipboard.text = copy_string(text);
    clipboard.source = create(data_device_manager, WL_DATA_DEVICE_MANAGER_CREATE_DATA_SOURCE, core.wl_data_source_interface, version(data_device_manager));
    wl.wl_proxy_add_listener(clipboard.source, *data_source_listener, null);
    for TEXT_MIME_TYPES send(clipboard.source, WL_DATA_SOURCE_OFFER, address(temp_c_string(it)));
    send(data_device, WL_DATA_DEVICE_SET_SELECTION, address(clipboard.source), input_serial);
    wl.wl_display_flush(display);
}

wayland_set_cursor :: (cursor: Cursor) {
    if cursor == pointer.cursor return;
    pointer.cursor = cursor;
    if !pointer.edge apply_cursor();
}

wayland_set_title :: (title: string) {
    if toplevel send(toplevel, XDG_TOPLEVEL_SET_TITLE, address(temp_c_string(title)));
}

wayland_window_move :: () {
    // Only with a real button held: the compositor moves the window from that press.
    if toplevel && seat && pointer.buttons_held send(toplevel, XDG_TOPLEVEL_MOVE, address(seat), pointer.press_serial);
}

wayland_window_toggle_maximized :: () {
    if toplevel send(toplevel, cast(u32) ifx window_state.maximized then XDG_TOPLEVEL_UNSET_MAXIMIZED else XDG_TOPLEVEL_SET_MAXIMIZED);
}

wayland_window_minimize :: () {
    if toplevel send(toplevel, XDG_TOPLEVEL_SET_MINIMIZED);
}

wayland_window_menu :: (x: float, y: float) {
    if toplevel && seat {
        send(toplevel, XDG_TOPLEVEL_SHOW_WINDOW_MENU, address(seat), pointer.press_serial,
             int_arg(cast(s32) (x / platform.dpi_scale)), int_arg(cast(s32) (y / platform.dpi_scale)));
    }
}

#scope_file

POSIX :: #import "POSIX";

display:  *void;
registry: *void;
broken:   bool;   // The connection failed: don't touch it again.

// Globals.
compositor:               *void;
wm_base:                  *void;
seat:                     *void;
shm:                      *void;
data_device_manager:      *void;
decoration_manager:       *void;
fractional_scale_manager: *void;
viewporter:               *void;
cursor_shape_manager:     *void;
activation:               *void;
outputs: [..] Output;

Output :: struct {
    proxy:  *void;
    name:   u32;           // In the registry.
    refresh_mhz: s32;      // Of the current mode.
    scale:  s32 = 1;
    entered: bool;         // The window is (partly) on it.
}

// The window.
surface:          *void;
xdg_surface:      *void;
toplevel:         *void;
decoration:       *void;
fractional_scale: *void;
viewport:         *void;
configured:       bool;

logical: struct { width, height: s32; };   // The window's size in surface coordinates.

window_state: struct {
    // From the last xdg_toplevel.configure, applied by xdg_surface.configure.
    pending_width, pending_height: s32;
    pending_maximized, pending_suspended: bool;
    maximized:  bool;    // Maximized, fullscreen or tiled: no edges to drag.
    floating_width, floating_height: s32;   // The size before it was, to go back to.
    bounds_width, bounds_height: s32;   // The largest a window should be (0: no idea).
}

scale_120: u32;          // wp_fractional_scale_v1's preferred scale, in 120ths (0 until it says).
buffer_scale: s32 = 1;   // wl_surface.preferred_buffer_scale, for compositors without fractional scaling.

// The serial of the last input event: clipboard ownership needs one.
input_serial: u32;

// Wakes from the compositor, the eventfd or a timeout, then handles what
// came. libwayland's read protocol: another thread (Vulkan's) may read the
// socket too.
dispatch :: (timeout_ms: s32) {
    if !display || broken return;
    timeout := timeout_ms;
    while wl.wl_display_prepare_read(display) != 0 {
        // Events already read (by another thread) come first.
        if wl.wl_display_dispatch_pending(display) < 0 { connection_lost(); return; }
        timeout = 0;
    }
    wl.wl_display_flush(display);
    fds: [2] POSIX.pollfd;
    fds[0].fd, fds[0].events = wl.wl_display_get_fd(display), POSIX.POLLIN;
    fds[1].fd, fds[1].events = linux_wake_fd, POSIX.POLLIN;
    POSIX.poll(fds.data, fds.count, timeout);
    if fds[0].revents & POSIX.POLLIN {
        if wl.wl_display_read_events(display) < 0 { connection_lost(); return; }
    } else {
        wl.wl_display_cancel_read(display);
    }
    if fds[1].revents & POSIX.POLLIN linux_drain_wake();
    if wl.wl_display_dispatch_pending(display) < 0 connection_lost();
}

connection_lost :: () {
    if broken return;
    broken = true;
    log_error("Lost the connection to the Wayland compositor (error %).\n", wl.wl_display_get_error(display));
    platform.quit_requested = true;
}

// Requests. Each is wl_proxy_marshal_flags with its arguments as integers
// (C's variadic arguments: ints, pointers and fds all go in integer
// registers), padded to six.

send :: (proxy: *void, opcode: u32, args: ..u64) {
    marshal(proxy, opcode, null, version(proxy), 0, args);
}

// A request that makes an object: `interface` and `object_version` are the
// new object's. Its new_id argument is the 0 among `args` (or the first,
// when there are none).
create :: (proxy: *void, opcode: u32, iface: *Wl_Interface, object_version: u32, args: ..u64) -> *void {
    return marshal(proxy, opcode, iface, object_version, 0, args);
}

// A destructor request: the object is gone afterwards.
destroy :: (proxy: *void, opcode: u32) {
    marshal(proxy, opcode, null, version(proxy), WL_MARSHAL_FLAG_DESTROY, .[]);
}

marshal :: (proxy: *void, opcode: u32, iface: *Wl_Interface, object_version: u32, flags: u32, args: [] u64) -> *void {
    a: [6] u64;
    for args a[it_index] = it;
    return wl.wl_proxy_marshal_flags(proxy, opcode, iface, object_version, flags, a[0], a[1], a[2], a[3], a[4], a[5]);
}

version :: (proxy: *void) -> u32 { return wl.wl_proxy_get_version(proxy); }
address :: (p: *void) -> u64 { return cast(u64) p; }
int_arg :: (v: s32) -> u64 { return cast(u64) cast,no_check(u32) v; }

bind :: (name: u32, iface: *Wl_Interface, offered: u32, wanted: u32) -> *void {
    v := min(offered, wanted);
    return create(registry, WL_REGISTRY_BIND, iface, v, name, address(iface.name), v, 0);
}

// The registry.

registry_listener := Wl_Registry_Listener.{on_global, on_global_remove};

on_global :: (data: *void, registry_: *void, name: u32, interface_name: *u8, offered: u32) #c_call {
    push_context linux_context {
        iface := to_string(interface_name);
        if iface == {
            case "wl_compositor";          compositor = bind(name, core.wl_compositor_interface, offered, 6);
            case "xdg_wm_base";
                wm_base = bind(name, *xdg_wm_base_interface, offered, 6);
                wl.wl_proxy_add_listener(wm_base, *wm_base_listener, null);
            case "wl_seat";
                if seat return;   // One seat: the first.
                seat = bind(name, core.wl_seat_interface, offered, 8);
                wl.wl_proxy_add_listener(seat, *seat_listener, null);
            case "wl_shm";                 shm = bind(name, core.wl_shm_interface, offered, 1);
            case "wl_data_device_manager"; data_device_manager = bind(name, core.wl_data_device_manager_interface, offered, 3);
            case "zxdg_decoration_manager_v1";      decoration_manager = bind(name, *zxdg_decoration_manager_v1_interface, offered, 1);
            case "wp_fractional_scale_manager_v1";  fractional_scale_manager = bind(name, *wp_fractional_scale_manager_v1_interface, offered, 1);
            case "wp_viewporter";                   viewporter = bind(name, *wp_viewporter_interface, offered, 1);
            case "wp_cursor_shape_manager_v1";      cursor_shape_manager = bind(name, *wp_cursor_shape_manager_v1_interface, offered, 1);
            case "xdg_activation_v1";               activation = bind(name, *xdg_activation_v1_interface, offered, 1);
            case "wl_output";
                output := array_add(*outputs);
                output.name  = name;
                output.proxy = bind(name, core.wl_output_interface, offered, 4);
                wl.wl_proxy_add_listener(output.proxy, *output_listener, null);
        }
        if data_device_manager && seat && !data_device {
            data_device = create(data_device_manager, WL_DATA_DEVICE_MANAGER_GET_DATA_DEVICE, core.wl_data_device_interface, version(data_device_manager), 0, address(seat));
            wl.wl_proxy_add_listener(data_device, *data_device_listener, null);
        }
    }
}

on_global_remove :: (data: *void, registry_: *void, name: u32) #c_call {
    push_context linux_context {
        for outputs if it.name == name {   // A monitor was unplugged.
            if version(it.proxy) >= 3 destroy(it.proxy, WL_OUTPUT_RELEASE);
            array_unordered_remove_by_index(*outputs, it_index);
            update_scale_and_rate();
            break;
        }
    }
}

wm_base_listener := Xdg_Wm_Base_Listener.{on_ping};

on_ping :: (data: *void, base: *void, serial: u32) #c_call {
    push_context linux_context { send(wm_base, XDG_WM_BASE_PONG, serial); }   // Still alive.
}

// Outputs (monitors): their refresh rates and integer scales.

output_listener := Wl_Output_Listener.{on_output_geometry, on_output_mode, on_output_done, on_output_scale, on_output_name, on_output_name};

on_output_geometry :: (data: *void, proxy: *void, x: s32, y: s32, mm_w: s32, mm_h: s32, subpixel: s32, make: *u8, model: *u8, transform: s32) #c_call {}
on_output_name :: (data: *void, proxy: *void, name: *u8) #c_call {}

on_output_mode :: (data: *void, proxy: *void, flags: u32, width: s32, height: s32, refresh_mhz: s32) #c_call {
    push_context linux_context {
        if !(flags & WL_OUTPUT_MODE_CURRENT) return;
        for * outputs if it.proxy == proxy it.refresh_mhz = refresh_mhz;
    }
}

on_output_scale :: (data: *void, proxy: *void, factor: s32) #c_call {
    push_context linux_context { for * outputs if it.proxy == proxy it.scale = factor; }
}

on_output_done :: (data: *void, proxy: *void) #c_call {
    push_context linux_context { update_scale_and_rate(); }
}

// The surface: which outputs it is on, and the scale the compositor wants.

surface_listener := Wl_Surface_Listener.{on_surface_enter, on_surface_leave, on_preferred_buffer_scale, on_preferred_buffer_transform};

on_surface_enter :: (data: *void, proxy: *void, output: *void) #c_call {
    push_context linux_context {
        for * outputs if it.proxy == output it.entered = true;
        update_scale_and_rate();
    }
}

on_surface_leave :: (data: *void, proxy: *void, output: *void) #c_call {
    push_context linux_context {
        for * outputs if it.proxy == output it.entered = false;
        update_scale_and_rate();
    }
}

on_preferred_buffer_scale :: (data: *void, proxy: *void, factor: s32) #c_call {
    push_context linux_context {
        buffer_scale = max(factor, 1);
        update_scale_and_rate();
    }
}

on_preferred_buffer_transform :: (data: *void, proxy: *void, transform: u32) #c_call {}

fractional_scale_listener := Wp_Fractional_Scale_Listener.{on_preferred_scale};

on_preferred_scale :: (data: *void, proxy: *void, scale: u32) #c_call {
    push_context linux_context {
        scale_120 = scale;
        update_scale_and_rate();
    }
}

// The scale: the compositor's fractional one, else its integer buffer scale
// (said outright since wl_compositor 6, else the largest of the outputs the
// window is on). The refresh rate: the fastest of those outputs.
update_scale_and_rate :: () {
    integer := buffer_scale;
    hz: float;
    for outputs {
        if !it.entered continue;
        if compositor && version(compositor) < 6 integer = max(integer, it.scale);
        hz = max(hz, it.refresh_mhz / 1000.0);
    }
    if hz >= 24 && hz <= 1000 && hz != platform.refresh_hz {
        platform.refresh_hz = hz;
        platform.needs_redraw = true;
    }
    scale := ifx scale_120 && viewport then scale_120 / 120.0 else cast(float) integer;
    if scale != platform.dpi_scale || (!viewport && integer != applied_buffer_scale) {
        platform.dpi_scale = scale;
        apply_size();
    }
}

applied_buffer_scale: s32 = 1;

// The window's pixel size from its logical size and scale. With a viewport
// the buffer is round(logical * scale) and the compositor shows it at the
// logical size; without one, the buffer scale says how many pixels per unit.
// Both take effect with the next frame Vulkan presents, the buffer of the
// new size: the state is double-buffered until that commit.
apply_size :: () {
    if !surface return;
    scale := platform.dpi_scale;
    platform.width  = cast(s32) (logical.width  * scale + 0.5);
    platform.height = cast(s32) (logical.height * scale + 0.5);
    if viewport {
        send(viewport, WP_VIEWPORT_SET_DESTINATION, int_arg(logical.width), int_arg(logical.height));
    } else if version(surface) >= 3 {
        applied_buffer_scale = cast(s32) scale;
        send(surface, WL_SURFACE_SET_BUFFER_SCALE, int_arg(applied_buffer_scale));
    }
    // Opaque: the compositor needn't draw what's behind the window.
    region := create(compositor, WL_COMPOSITOR_CREATE_REGION, core.wl_region_interface, version(compositor));
    send(region, WL_REGION_ADD, 0, 0, int_arg(logical.width), int_arg(logical.height));
    send(surface, WL_SURFACE_SET_OPAQUE_REGION, address(region));
    destroy(region, WL_REGION_DESTROY);
    platform.needs_redraw = true;
}

// The window's configuration: its size and state, acknowledged once applied.

xdg_surface_listener := Xdg_Surface_Listener.{on_xdg_surface_configure};

on_xdg_surface_configure :: (data: *void, proxy: *void, serial: u32) #c_call {
    push_context linux_context {
        s := *window_state;
        if s.pending_maximized && !s.maximized {
            s.floating_width, s.floating_height = logical.width, logical.height;
        }
        if s.pending_width > 0 && s.pending_height > 0 {
            logical.width, logical.height = s.pending_width, s.pending_height;
        } else if !s.pending_maximized && s.maximized && s.floating_width > 0 {
            // Restored, and the size is ours to choose: the one it had.
            logical.width, logical.height = s.floating_width, s.floating_height;
        } else if !configured && s.bounds_width > 0 && s.bounds_height > 0 {
            // Ours to choose: the size asked for, within the work area.
            logical.width  = min(logical.width, s.bounds_width);
            logical.height = min(logical.height, s.bounds_height);
        }
        logical.width  = max(logical.width, 1);
        logical.height = max(logical.height, 1);
        s.maximized = s.pending_maximized;
        platform.maximized = s.maximized;
        if s.pending_suspended != platform.minimized {
            platform.minimized = s.pending_suspended;
        }
        send(xdg_surface, XDG_SURFACE_ACK_CONFIGURE, serial);
        configured = true;
        apply_size();
    }
}

toplevel_listener := Xdg_Toplevel_Listener.{on_toplevel_configure, on_toplevel_close, on_toplevel_bounds, on_toplevel_capabilities};

on_toplevel_configure :: (data: *void, proxy: *void, width: s32, height: s32, states: *Wl_Array) #c_call {
    push_context linux_context {
        s := *window_state;
        s.pending_width, s.pending_height = width, height;
        s.pending_maximized, s.pending_suspended = false, false;
        for 0..cast(s64) states.size / 4 - 1 {
            if (cast(*u32) states.data)[it] == {
                case XDG_TOPLEVEL_STATE_MAXIMIZED;  #through;
                case XDG_TOPLEVEL_STATE_FULLSCREEN; #through;
                case XDG_TOPLEVEL_STATE_TILED_LEFT; #through;
                case XDG_TOPLEVEL_STATE_TILED_RIGHT; #through;
                case XDG_TOPLEVEL_STATE_TILED_TOP;  #through;
                case XDG_TOPLEVEL_STATE_TILED_BOTTOM;
                    s.pending_maximized = true;
                case XDG_TOPLEVEL_STATE_SUSPENDED;   // Hidden: no frames until it's back.
                    s.pending_suspended = true;
            }
        }
    }
}

on_toplevel_close :: (data: *void, proxy: *void) #c_call {
    push_context linux_context { platform.quit_requested = true; }
}

on_toplevel_bounds :: (data: *void, proxy: *void, width: s32, height: s32) #c_call {
    push_context linux_context { window_state.bounds_width, window_state.bounds_height = width, height; }
}

on_toplevel_capabilities :: (data: *void, proxy: *void, capabilities: *Wl_Array) #c_call {}

decoration_listener := Zxdg_Toplevel_Decoration_Listener.{on_decoration_configure};

on_decoration_configure :: (data: *void, proxy: *void, mode: u32) #c_call {
    push_context linux_context {
        client := mode != ZXDG_TOPLEVEL_DECORATION_MODE_SERVER_SIDE;
        if client != platform.client_decorations {
            platform.client_decorations = client;
            platform.needs_redraw = true;
        }
    }
}

// The seat: a pointer and a keyboard.

seat_listener := Wl_Seat_Listener.{on_seat_capabilities, on_seat_name};

on_seat_name :: (data: *void, proxy: *void, name: *u8) #c_call {}

on_seat_capabilities :: (data: *void, proxy: *void, capabilities: u32) #c_call {
    push_context linux_context {
        has_pointer  := (capabilities & WL_SEAT_CAPABILITY_POINTER) != 0;
        has_keyboard := (capabilities & WL_SEAT_CAPABILITY_KEYBOARD) != 0;
        if has_pointer && !pointer.proxy {
            pointer.proxy = create(seat, WL_SEAT_GET_POINTER, core.wl_pointer_interface, version(seat));
            wl.wl_proxy_add_listener(pointer.proxy, *pointer_listener, null);
            if cursor_shape_manager {
                pointer.shape_device = create(cursor_shape_manager, WP_CURSOR_SHAPE_MANAGER_GET_POINTER, *wp_cursor_shape_device_v1_interface, 1, 0, address(pointer.proxy));
            }
        } else if !has_pointer && pointer.proxy {
            if pointer.shape_device destroy(pointer.shape_device, WP_CURSOR_SHAPE_DEVICE_DESTROY);
            if version(pointer.proxy) >= 3 destroy(pointer.proxy, WL_POINTER_RELEASE);
            else wl.wl_proxy_destroy(pointer.proxy);
            pointer.proxy, pointer.shape_device = null, null;
        }
        if has_keyboard && !keyboard.proxy {
            keyboard.proxy = create(seat, WL_SEAT_GET_KEYBOARD, core.wl_keyboard_interface, version(seat));
            wl.wl_proxy_add_listener(keyboard.proxy, *keyboard_listener, null);
        } else if !has_keyboard && keyboard.proxy {
            if version(keyboard.proxy) >= 3 destroy(keyboard.proxy, WL_KEYBOARD_RELEASE);
            else wl.wl_proxy_destroy(keyboard.proxy);
            keyboard.proxy = null;
            keyboard.repeat_key = 0;
        }
    }
}

// The pointer. Positions arrive in surface coordinates (24.8 fixed point);
// the app's are pixels.

Pointer :: struct {
    proxy:         *void;
    shape_device:  *void;     // wp_cursor_shape_device_v1, if the compositor draws cursors by name.
    enter_serial:  u32;       // For setting the cursor.
    press_serial:  u32;       // For moving, resizing, the window menu.
    buttons_held:  s32;       // Pressed on the window, not yet released.
    x, y:          float;     // Surface coordinates.
    inside:        bool;
    cursor:        Cursor;    // What the app asks for.
    edge:          u32;       // The window edge under the pointer (client decorations), or 0.
    shown_shape:   u32;       // The cursor shape now shown (0: none yet).

    // Scrolling within one frame (wl_pointer.frame groups axis events).
    axis_source:   u32;
    discrete:      float;     // Wheel notches, from axis_value120 or axis_discrete.
    continuous:    float;     // Surface units, from axis.
}
pointer: Pointer;

pointer_listener := Wl_Pointer_Listener.{
    on_pointer_enter, on_pointer_leave, on_pointer_motion, on_pointer_button, on_pointer_axis, on_pointer_frame,
    on_pointer_axis_source, on_pointer_axis_stop, on_pointer_axis_discrete, on_pointer_axis_value120, on_pointer_axis_direction,
};

on_pointer_enter :: (data: *void, proxy: *void, serial: u32, surf: *void, sx: s32, sy: s32) #c_call {
    push_context linux_context {
        if surf != surface return;
        pointer.enter_serial = serial;
        pointer.inside = true;
        pointer.shown_shape = 0;   // Each enter needs the cursor set again.
        pointer_moved(sx, sy);
        apply_cursor();
    }
}

on_pointer_leave :: (data: *void, proxy: *void, serial: u32, surf: *void) #c_call {
    push_context linux_context {
        pointer.inside = false;
        pointer.edge = 0;
        pointer.buttons_held = 0;
        if linux_dialog_open || input.synthetic return;
        // The pointer only leaves while a button is held when the compositor
        // took it (moving or resizing the window): the release won't come.
        for input.mouse_down if it input_on_mouse_button(xx it_index, false);
        input_on_mouse_leave();
    }
}

on_pointer_motion :: (data: *void, proxy: *void, time: u32, sx: s32, sy: s32) #c_call {
    push_context linux_context { pointer_moved(sx, sy); }
}

pointer_moved :: (sx: s32, sy: s32) {
    pointer.x, pointer.y = sx / 256.0, sy / 256.0;
    edge := edge_at(pointer.x, pointer.y);
    if edge != pointer.edge {
        pointer.edge = edge;
        apply_cursor();
    }
    if linux_dialog_open || input.synthetic return;
    if edge {   // On the frame, not in the app.
        if input.mouse_inside input_on_mouse_leave();
        return;
    }
    input_on_mouse_move(pointer.x * platform.dpi_scale, pointer.y * platform.dpi_scale);
}

on_pointer_button :: (data: *void, proxy: *void, serial: u32, time: u32, button: u32, state: u32) #c_call {
    push_context linux_context {
        down := state == WL_POINTER_BUTTON_STATE_PRESSED;
        if down { pointer.press_serial = serial; input_serial = serial; }
        pointer.buttons_held = max(pointer.buttons_held + cast(s32) ifx down then 1 else -1, 0);
        if linux_dialog_open return;
        if pointer.edge && down && button == BTN_LEFT {
            send(toplevel, XDG_TOPLEVEL_RESIZE, address(seat), serial, pointer.edge);
            return;
        }
        if input.synthetic return;
        mouse_button: Mouse_Button;
        if button == {
            case BTN_LEFT;   mouse_button = .LEFT;
            case BTN_RIGHT;  mouse_button = .RIGHT;
            case BTN_MIDDLE; mouse_button = .MIDDLE;
            case; return;   // Back, forward.
        }
        if !down && !input.mouse_down[mouse_button] return;   // Pressed on the frame.
        input_on_mouse_move(pointer.x * platform.dpi_scale, pointer.y * platform.dpi_scale);
        input_on_mouse_button(mouse_button, down);
    }
}

on_pointer_axis :: (data: *void, proxy: *void, time: u32, axis: u32, value: s32) #c_call {
    push_context linux_context {
        if axis != WL_POINTER_AXIS_VERTICAL_SCROLL return;
        pointer.continuous += value / 256.0;
        if version(pointer.proxy) < 5 on_pointer_frame(null, proxy);   // No frames: each event stands alone.
    }
}

on_pointer_axis_source :: (data: *void, proxy: *void, source: u32) #c_call {
    push_context linux_context { pointer.axis_source = source; }
}

on_pointer_axis_stop :: (data: *void, proxy: *void, time: u32, axis: u32) #c_call {}

on_pointer_axis_discrete :: (data: *void, proxy: *void, axis: u32, discrete: s32) #c_call {
    push_context linux_context { if axis == WL_POINTER_AXIS_VERTICAL_SCROLL pointer.discrete += cast(float) discrete; }
}

on_pointer_axis_value120 :: (data: *void, proxy: *void, axis: u32, value120: s32) #c_call {
    push_context linux_context { if axis == WL_POINTER_AXIS_VERTICAL_SCROLL pointer.discrete += value120 / 120.0; }
}

on_pointer_axis_direction :: (data: *void, proxy: *void, axis: u32, direction: u32) #c_call {}

// The end of a group of pointer events: the scroll they add up to. A wheel
// scrolls by its notches; a touchpad by distance, turned into notches of the
// UI's scroll step (three rows), as on macOS, so content follows the fingers.
on_pointer_frame :: (data: *void, proxy: *void) #c_call {
    push_context linux_context {
        defer { pointer.discrete, pointer.continuous, pointer.axis_source = 0, 0, WL_POINTER_AXIS_SOURCE_WHEEL; }
        if linux_dialog_open || input.synthetic || pointer.edge return;
        notches: float;
        if pointer.discrete != 0                                   notches = pointer.discrete;
        else if pointer.axis_source == WL_POINTER_AXIS_SOURCE_WHEEL notches = pointer.continuous / 10;   // libinput's 10 units a notch.
        else                                                       notches = pointer.continuous / PRECISE_UNITS_PER_NOTCH;
        if notches == 0 return;
        input.wheel -= notches;   // Wayland's positive is down; the app's is up.
        platform.needs_redraw = true;
    }
}

PRECISE_UNITS_PER_NOTCH :: 84.0;   // 3 * theme.row_height, as on macOS.

// The edges of a window whose frame we draw: within this many surface units
// of one, the pointer resizes the window.
RESIZE_BORDER :: 5.0;
RESIZE_CORNER :: 16.0;   // Along the edge from a corner, the corner.

edge_at :: (x: float, y: float) -> u32 {
    if !platform.client_decorations || window_state.maximized || !toplevel return 0;
    w, h := cast(float) logical.width, cast(float) logical.height;
    edge: u32;
    near_left   := x < RESIZE_BORDER;
    near_right  := x >= w - RESIZE_BORDER;
    near_top    := y < RESIZE_BORDER;
    near_bottom := y >= h - RESIZE_BORDER;
    if !near_left && !near_right && !near_top && !near_bottom return 0;
    // Close to a corner along either edge counts as the corner.
    if near_top || near_bottom { near_left = near_left || x < RESIZE_CORNER; near_right = near_right || x >= w - RESIZE_CORNER; }
    if near_left || near_right { near_top = near_top || y < RESIZE_CORNER; near_bottom = near_bottom || y >= h - RESIZE_CORNER; }
    if near_top    edge |= XDG_TOPLEVEL_RESIZE_EDGE_TOP;
    if near_bottom edge |= XDG_TOPLEVEL_RESIZE_EDGE_BOTTOM;
    if near_left   edge |= XDG_TOPLEVEL_RESIZE_EDGE_LEFT;
    if near_right  edge |= XDG_TOPLEVEL_RESIZE_EDGE_RIGHT;
    return edge;
}

// Shows the cursor for the window edge under the pointer, else the app's:
// by name if the compositor draws cursors (cursor-shape), else from the
// cursor theme (libwayland-cursor).
apply_cursor :: () {
    if !pointer.proxy || !pointer.inside return;
    shape := cursor_shape();
    if shape == pointer.shown_shape return;
    pointer.shown_shape = shape;
    if pointer.shape_device {
        send(pointer.shape_device, WP_CURSOR_SHAPE_DEVICE_SET_SHAPE, pointer.enter_serial, shape);
        return;
    }
    image, scale := theme_cursor(shape);
    if !image {
        send(pointer.proxy, WL_POINTER_SET_CURSOR, pointer.enter_serial, 0, 0, 0);   // None: the compositor's default.
        return;
    }
    if !cursor_surface cursor_surface = create(compositor, WL_COMPOSITOR_CREATE_SURFACE, core.wl_surface_interface, version(compositor));
    buffer := wl_cursor.wl_cursor_image_get_buffer(image);
    if version(cursor_surface) >= 3 send(cursor_surface, WL_SURFACE_SET_BUFFER_SCALE, int_arg(scale));
    send(cursor_surface, WL_SURFACE_ATTACH, address(buffer), 0, 0);
    send(cursor_surface, WL_SURFACE_DAMAGE, 0, 0, int_arg(0x7FFF_FFFF), int_arg(0x7FFF_FFFF));
    send(cursor_surface, WL_SURFACE_COMMIT);
    send(pointer.proxy, WL_POINTER_SET_CURSOR, pointer.enter_serial, address(cursor_surface),
         int_arg(cast(s32) (image.hotspot_x / cast(u32) scale)), int_arg(cast(s32) (image.hotspot_y / cast(u32) scale)));
}

cursor_shape :: () -> u32 {
    if pointer.edge == {
        case XDG_TOPLEVEL_RESIZE_EDGE_TOP;          return CURSOR_SHAPE_N_RESIZE;
        case XDG_TOPLEVEL_RESIZE_EDGE_BOTTOM;       return CURSOR_SHAPE_S_RESIZE;
        case XDG_TOPLEVEL_RESIZE_EDGE_LEFT;         return CURSOR_SHAPE_W_RESIZE;
        case XDG_TOPLEVEL_RESIZE_EDGE_RIGHT;        return CURSOR_SHAPE_E_RESIZE;
        case XDG_TOPLEVEL_RESIZE_EDGE_TOP_LEFT;     return CURSOR_SHAPE_NW_RESIZE;
        case XDG_TOPLEVEL_RESIZE_EDGE_TOP_RIGHT;    return CURSOR_SHAPE_NE_RESIZE;
        case XDG_TOPLEVEL_RESIZE_EDGE_BOTTOM_LEFT;  return CURSOR_SHAPE_SW_RESIZE;
        case XDG_TOPLEVEL_RESIZE_EDGE_BOTTOM_RIGHT; return CURSOR_SHAPE_SE_RESIZE;
    }
    if pointer.cursor == {
        case .HAND; return CURSOR_SHAPE_POINTER;
        case .TEXT; return CURSOR_SHAPE_TEXT;
    }
    return CURSOR_SHAPE_DEFAULT;
}

// A cursor shape's image from the user's cursor theme (XCURSOR_THEME, at
// XCURSOR_SIZE), at the integer scale above the window's, and that scale.
theme_cursor :: (shape: u32) -> *Wl_Cursor_Image, s32 {
    scale := cast(s32) ceil(platform.dpi_scale);
    if !wl_cursor_loaded {
        wl_cursor_loaded = true;
        if !dl_load(*wl_cursor, .["libwayland-cursor.so.0"]) log("Wayland: libwayland-cursor is missing; the compositor's cursor is used.\n");
    }
    if !wl_cursor.wl_cursor_theme_load || !shm return null, 1;
    if !cursor_theme || cursor_theme_scale != scale {
        if cursor_theme wl_cursor.wl_cursor_theme_destroy(cursor_theme);
        size, ok := string_to_int(to_string(POSIX.getenv("XCURSOR_SIZE")));
        if !ok || size <= 0 size = 24;
        theme := POSIX.getenv("XCURSOR_THEME");
        cursor_theme = wl_cursor.wl_cursor_theme_load(theme, cast(s32) (size * scale), shm);
        cursor_theme_scale = scale;
        if !cursor_theme return null, 1;
    }
    for CURSOR_NAMES {
        if it.shape != shape continue;
        for name: it.names {
            cursor := wl_cursor.wl_cursor_theme_get_cursor(cursor_theme, temp_c_string(name));
            if cursor && cursor.image_count return cursor.images[0], scale;
        }
    }
    return null, 1;
}

// Cursor theme names for each shape: the CSS name, then the X11 one older
// themes have.
CURSOR_NAMES :: struct { shape: u32; names: [2] string; }.[
    .{CURSOR_SHAPE_DEFAULT,   .["default",   "left_ptr"]},
    .{CURSOR_SHAPE_POINTER,   .["pointer",   "hand2"]},
    .{CURSOR_SHAPE_TEXT,      .["text",      "xterm"]},
    .{CURSOR_SHAPE_N_RESIZE,  .["n-resize",  "top_side"]},
    .{CURSOR_SHAPE_S_RESIZE,  .["s-resize",  "bottom_side"]},
    .{CURSOR_SHAPE_W_RESIZE,  .["w-resize",  "left_side"]},
    .{CURSOR_SHAPE_E_RESIZE,  .["e-resize",  "right_side"]},
    .{CURSOR_SHAPE_NW_RESIZE, .["nw-resize", "top_left_corner"]},
    .{CURSOR_SHAPE_NE_RESIZE, .["ne-resize", "top_right_corner"]},
    .{CURSOR_SHAPE_SW_RESIZE, .["sw-resize", "bottom_left_corner"]},
    .{CURSOR_SHAPE_SE_RESIZE, .["se-resize", "bottom_right_corner"]},
];

cursor_surface: *void;
cursor_theme: *void;
cursor_theme_scale: s32;
wl_cursor_loaded: bool;

// The keyboard: an XKB keymap from the compositor, keys as evdev codes.

Keyboard :: struct {
    proxy:   *void;
    keymap:  *void;
    state:   *void;
    compose_table: *void;
    compose: *void;
    repeat_rate:  s32 = 25;    // Per second; 0: keys don't repeat.
    repeat_delay: s32 = 600;   // Milliseconds.
    repeat_key:   u32;         // The XKB keycode repeating (0: none).
    repeat_next:  float64;
}
keyboard: Keyboard;

keyboard_listener := Wl_Keyboard_Listener.{on_keymap, on_keyboard_enter, on_keyboard_leave, on_key, on_modifiers, on_repeat_info};

on_keymap :: (data: *void, proxy: *void, format: u32, fd: s32, size: u32) #c_call {
    push_context linux_context {
        defer POSIX.close(fd);
        if format != WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1 return;
        text := POSIX.mmap(null, size, POSIX.PROT_READ, POSIX.MAP_PRIVATE, fd, 0);
        if text == POSIX.MAP_FAILED return;
        defer POSIX.munmap(text, size);
        keymap := xkb.xkb_keymap_new_from_string(xkb_context, text, XKB_KEYMAP_FORMAT_TEXT_V1, 0);
        if !keymap { log_error("Wayland: the compositor's keymap didn't compile.\n"); return; }
        if keyboard.state  xkb.xkb_state_unref(keyboard.state);
        if keyboard.keymap xkb.xkb_keymap_unref(keyboard.keymap);
        keyboard.keymap = keymap;
        keyboard.state  = xkb.xkb_state_new(keymap);
        if !keyboard.compose && xkb.xkb_compose_table_new_from_locale {
            // Dead keys and the Compose key, as the user's locale defines them.
            locale := POSIX.getenv("LC_ALL");
            if !locale || !locale[0] locale = POSIX.getenv("LC_CTYPE");
            if !locale || !locale[0] locale = POSIX.getenv("LANG");
            if !locale || !locale[0] locale = "C";
            keyboard.compose_table = xkb.xkb_compose_table_new_from_locale(xkb_context, locale, 0);
            if keyboard.compose_table keyboard.compose = xkb.xkb_compose_state_new(keyboard.compose_table, 0);
        }
    }
}

on_keyboard_enter :: (data: *void, proxy: *void, serial: u32, surf: *void, keys: *Wl_Array) #c_call {
    push_context linux_context {
        input_serial = serial;
        platform.has_focus = true;
        platform.needs_redraw = true;
    }
}

on_keyboard_leave :: (data: *void, proxy: *void, serial: u32, surf: *void) #c_call {
    push_context linux_context {
        platform.has_focus = false;
        keyboard.repeat_key = 0;
        input_release_all();   // Keys released elsewhere never tell us.
    }
}

on_key :: (data: *void, proxy: *void, serial: u32, time: u32, key: u32, state: u32) #c_call {
    push_context linux_context {
        input_serial = serial;
        if !keyboard.state return;
        code := key + 8;   // evdev to XKB.
        down := state == WL_KEYBOARD_KEY_STATE_PRESSED;
        if !down && keyboard.repeat_key == code keyboard.repeat_key = 0;
        if linux_dialog_open return;
        mapped := key_of(code);
        if mapped != .UNKNOWN input_on_key(xx mapped, down);
        platform.needs_redraw = true;
        if !down return;
        type_key(code, true);
        if keyboard.repeat_rate > 0 && xkb.xkb_keymap_key_repeats(keyboard.keymap, code) {
            keyboard.repeat_key  = code;
            keyboard.repeat_next = seconds_since_init() + keyboard.repeat_delay / 1000.0;
        }
    }
}

on_modifiers :: (data: *void, proxy: *void, serial: u32, depressed: u32, latched: u32, locked: u32, group: u32) #c_call {
    push_context linux_context {
        if !keyboard.state return;
        xkb.xkb_state_update_mask(keyboard.state, depressed, latched, locked, 0, 0, group);
        if linux_dialog_open return;
        // What is held, whatever was pressed while another window had the keyboard.
        MODIFIERS :: struct { name: *u8; key: Key; }.[
            .{"Shift", .SHIFT}, .{"Control", .CONTROL}, .{"Mod1", .ALT},
        ];
        for MODIFIERS {
            held := xkb.xkb_state_mod_name_is_active(keyboard.state, it.name, XKB_STATE_MODS_EFFECTIVE) > 0;
            if held != input.key_down[it.key] input_on_key(xx it.key, held);
        }
    }
}

on_repeat_info :: (data: *void, proxy: *void, rate: s32, delay: s32) #c_call {
    push_context linux_context {
        keyboard.repeat_rate, keyboard.repeat_delay = rate, delay;
        if rate <= 0 keyboard.repeat_key = 0;
    }
}

// The key, by its keysym in the current layout, then in the others, then by
// its place on a US keyboard (layouts with no Latin letters).
key_of :: (code: u32) -> Key {
    key := key_from_keysym(xkb.xkb_state_key_get_one_sym(keyboard.state, code));
    if key != .UNKNOWN return key;
    for layout: 0..cast(s64) xkb.xkb_keymap_num_layouts(keyboard.keymap) - 1 {
        syms: *u32;
        if xkb.xkb_keymap_key_get_syms_by_level(keyboard.keymap, code, xx layout, 0, *syms) > 0 {
            key = key_from_keysym(syms[0]);
            if key != .UNKNOWN return key;
        }
    }
    return key_from_keycode(code);
}

// The text a key types, through Compose when it is part of a sequence.
// Nothing with Ctrl or Alt held: that's a shortcut.
type_key :: (code: u32, first: bool) {
    if xkb.xkb_state_mod_name_is_active(keyboard.state, "Control", XKB_STATE_MODS_EFFECTIVE) > 0 return;
    if xkb.xkb_state_mod_name_is_active(keyboard.state, "Mod1", XKB_STATE_MODS_EFFECTIVE) > 0 return;
    buffer: [64] u8;
    n: s32;
    if keyboard.compose && first && xkb.xkb_compose_state_feed(keyboard.compose, xkb.xkb_state_key_get_one_sym(keyboard.state, code)) == XKB_COMPOSE_FEED_ACCEPTED {
        status := xkb.xkb_compose_state_get_status(keyboard.compose);
        if status == XKB_COMPOSE_COMPOSING return;
        if status == XKB_COMPOSE_CANCELLED { xkb.xkb_compose_state_reset(keyboard.compose); return; }
        if status == XKB_COMPOSE_COMPOSED {
            n = xkb.xkb_compose_state_get_utf8(keyboard.compose, buffer.data, buffer.count);
            xkb.xkb_compose_state_reset(keyboard.compose);
        }
    }
    if !n n = xkb.xkb_state_key_get_utf8(keyboard.state, code, buffer.data, buffer.count);
    text := to_string(buffer.data, clamp(n, 0, buffer.count - 1));
    i := 0;
    while i < text.count {
        cp := next_code_point(text, *i);
        if cp < 32 || cp == 127 continue;   // Control characters.
        array_add(*input.text, cp);
    }
}

// Wayland leaves repeating to us: a held key presses again after the delay,
// then at the rate.
repeat_keys :: () {
    if !keyboard.repeat_key || !keyboard.state || linux_dialog_open return;
    now := seconds_since_init();
    if now < keyboard.repeat_next return;
    if now - keyboard.repeat_next > 0.5 keyboard.repeat_next = now;   // We weren't running (a breakpoint): one repeat, not a burst.
    key := key_of(keyboard.repeat_key);
    while now >= keyboard.repeat_next {
        if key != .UNKNOWN input_on_key(xx key, true);
        type_key(keyboard.repeat_key, false);
        keyboard.repeat_next += 1.0 / keyboard.repeat_rate;
    }
    platform.needs_redraw = true;
}

xkb_context: *void;

// The clipboard. The program that copied answers whoever pastes; we keep the
// text while the selection is ours.

TEXT_MIME_TYPES :: string.["text/plain;charset=utf-8", "UTF8_STRING", "text/plain"];

Offer :: struct {
    proxy: *void;
    mime:  string;   // The best text type it has (heap), or empty.
}

Clipboard :: struct {
    source:    *void;    // Our wl_data_source while the selection is ours.
    text:      string;
    selection: *Offer;   // Someone else's selection, when it is theirs.
}
clipboard: Clipboard;
data_device: *void;

data_device_listener := Wl_Data_Device_Listener.{on_data_offer, on_drag_enter, on_drag_leave, on_drag_motion, on_drop, on_selection};

on_data_offer :: (data: *void, proxy: *void, offer_proxy: *void) #c_call {
    push_context linux_context {
        offer := New(Offer);
        offer.proxy = offer_proxy;
        wl.wl_proxy_add_listener(offer_proxy, *data_offer_listener, offer);
    }
}

on_selection :: (data: *void, proxy: *void, offer_proxy: *void) #c_call {
    push_context linux_context {
        if clipboard.selection free_offer(clipboard.selection);
        clipboard.selection = ifx offer_proxy then cast(*Offer) wl.wl_proxy_get_user_data(offer_proxy) else null;
    }
}

// Drag and drop: nothing is dropped on Uppies; the offers are let go.
drag_offer: *Offer;
on_drag_enter :: (data: *void, proxy: *void, serial: u32, surf: *void, x: s32, y: s32, offer_proxy: *void) #c_call {
    push_context linux_context {
        if drag_offer free_offer(drag_offer);
        drag_offer = ifx offer_proxy then cast(*Offer) wl.wl_proxy_get_user_data(offer_proxy) else null;
    }
}
on_drag_leave :: (data: *void, proxy: *void) #c_call {
    push_context linux_context { if drag_offer free_offer(drag_offer); drag_offer = null; }
}
on_drag_motion :: (data: *void, proxy: *void, time: u32, x: s32, y: s32) #c_call {}
on_drop :: (data: *void, proxy: *void) #c_call {
    push_context linux_context { if drag_offer free_offer(drag_offer); drag_offer = null; }
}

free_offer :: (offer: *Offer) {
    destroy(offer.proxy, WL_DATA_OFFER_DESTROY);
    free(offer.mime);
    free(offer);
}

data_offer_listener := Wl_Data_Offer_Listener.{on_offer_mime, on_offer_source_actions, on_offer_action};

on_offer_mime :: (data: *void, proxy: *void, mime_type: *u8) #c_call {
    push_context linux_context {
        offer := cast(*Offer) data;
        mime := to_string(mime_type);
        // The earlier in TEXT_MIME_TYPES, the better.
        rank :: (m: string) -> int { for TEXT_MIME_TYPES if it == m return it_index; return TEXT_MIME_TYPES.count; }
        if rank(mime) < rank(offer.mime) {
            free(offer.mime);
            offer.mime = copy_string(mime);
        }
    }
}
on_offer_source_actions :: (data: *void, proxy: *void, actions: u32) #c_call {}
on_offer_action :: (data: *void, proxy: *void, action: u32) #c_call {}

data_source_listener := Wl_Data_Source_Listener.{on_source_target, on_source_send, on_source_cancelled, on_source_drop_performed, on_source_finished, on_source_action};

// Someone pastes: write the text to them and close.
on_source_send :: (data: *void, proxy: *void, mime_type: *u8, fd: s32) #c_call {
    push_context linux_context {
        text := clipboard.text;
        at := 0;
        while at < text.count {
            written := POSIX.write(fd, text.data + at, cast(u64) (text.count - at));
            if written < 0 && POSIX.errno() == POSIX.EINTR continue;
            if written <= 0 break;
            at += written;
        }
        POSIX.close(fd);
    }
}

// Someone else copied: the selection isn't ours any more.
on_source_cancelled :: (data: *void, proxy: *void) #c_call {
    push_context linux_context {
        if proxy == clipboard.source {
            clipboard.source = null;
            free(clipboard.text);
            clipboard.text = "";
        }
        destroy(proxy, WL_DATA_SOURCE_DESTROY);
    }
}

on_source_target :: (data: *void, proxy: *void, mime_type: *u8) #c_call {}
on_source_drop_performed :: (data: *void, proxy: *void) #c_call {}
on_source_finished :: (data: *void, proxy: *void) #c_call {}
on_source_action :: (data: *void, proxy: *void, action: u32) #c_call {}

// libwayland-client's types, procedures and core interfaces.

Wl_Message :: struct {
    name:      *u8;
    signature: *u8;
    types:     **Wl_Interface;
}

Wl_Interface :: struct {
    name:         *u8;
    version:      s32;
    method_count: s32;
    methods:      *Wl_Message;
    event_count:  s32;
    events:       *Wl_Message;
}

Wl_Array :: struct {
    size:  u64;
    alloc: u64;
    data:  *void;
}

Libwayland :: struct {
    wl_display_connect:          (name: *u8) -> *void #c_call;
    wl_display_disconnect:       (display: *void) #c_call;
    wl_display_get_fd:           (display: *void) -> s32 #c_call;
    wl_display_roundtrip:        (display: *void) -> s32 #c_call;
    wl_display_dispatch_pending: (display: *void) -> s32 #c_call;
    wl_display_prepare_read:     (display: *void) -> s32 #c_call;
    wl_display_read_events:      (display: *void) -> s32 #c_call;
    wl_display_cancel_read:      (display: *void) #c_call;
    wl_display_flush:            (display: *void) -> s32 #c_call;
    wl_display_get_error:        (display: *void) -> s32 #c_call;
    // Variadic in C: the arguments are integers and pointers, which go in
    // integer registers either way; unused ones are ignored.
    wl_proxy_marshal_flags:      (proxy: *void, opcode: u32, iface: *Wl_Interface, version: u32, flags: u32,
                                  a: u64, b: u64, c: u64, d: u64, e: u64, f: u64) -> *void #c_call;
    wl_proxy_add_listener:       (proxy: *void, listener: *void, data: *void) -> s32 #c_call;
    wl_proxy_destroy:            (proxy: *void) #c_call;
    wl_proxy_get_version:        (proxy: *void) -> u32 #c_call;
    wl_proxy_get_user_data:      (proxy: *void) -> *void #c_call;
}
wl: Libwayland;

// The core protocol's interfaces, which libwayland-client exports as data.
Core_Interfaces :: struct {
    wl_registry_interface:               *Wl_Interface;
    wl_compositor_interface:             *Wl_Interface;
    wl_surface_interface:                *Wl_Interface;
    wl_region_interface:                 *Wl_Interface;
    wl_seat_interface:                   *Wl_Interface;
    wl_pointer_interface:                *Wl_Interface;
    wl_keyboard_interface:               *Wl_Interface;
    wl_output_interface:                 *Wl_Interface;
    wl_shm_interface:                    *Wl_Interface;
    wl_data_device_manager_interface:    *Wl_Interface;
    wl_data_device_interface:            *Wl_Interface;
    wl_data_source_interface:            *Wl_Interface;
    wl_data_offer_interface:             *Wl_Interface;
}
core: Core_Interfaces;

load_core_interfaces :: () -> bool {
    library := dl_open(.["libwayland-client.so.0"]);
    if !library return false;
    for member: type_info(Core_Interfaces).members {
        slot := cast(**Wl_Interface) (cast(*u8) *core + member.offset_in_bytes);
        slot.* = dl_symbol(library, member.name);
        if !slot.* { log_error("libwayland-client has no %.\n", member.name); return false; }
    }
    return true;
}

Wayland_Cursor :: struct {
    wl_cursor_theme_load:       (name: *u8, size: s32, shm: *void) -> *void #c_call;
    wl_cursor_theme_destroy:    (theme: *void) #c_call;
    wl_cursor_theme_get_cursor: (theme: *void, name: *u8) -> *Wl_Cursor #c_call;
    wl_cursor_image_get_buffer: (image: *Wl_Cursor_Image) -> *void #c_call;
}
wl_cursor: Wayland_Cursor;

Wl_Cursor :: struct {
    image_count: u32;
    images:      **Wl_Cursor_Image;
    name:        *u8;
}

Wl_Cursor_Image :: struct {
    width, height:        u32;
    hotspot_x, hotspot_y: u32;
    delay:                u32;
}

Xkbcommon :: struct {
    xkb_context_new:                  (flags: s32) -> *void #c_call;
    xkb_keymap_new_from_string:       (ctx: *void, text: *u8, format: s32, flags: s32) -> *void #c_call;
    xkb_keymap_unref:                 (keymap: *void) #c_call;
    xkb_keymap_num_layouts:           (keymap: *void) -> u32 #c_call;
    xkb_keymap_key_get_syms_by_level: (keymap: *void, key: u32, layout: u32, level: u32, syms: **u32) -> s32 #c_call;
    xkb_keymap_key_repeats:           (keymap: *void, key: u32) -> s32 #c_call;
    xkb_state_new:                    (keymap: *void) -> *void #c_call;
    xkb_state_unref:                  (state: *void) #c_call;
    xkb_state_update_mask:            (state: *void, depressed: u32, latched: u32, locked: u32, depressed_layout: u32, latched_layout: u32, locked_layout: u32) -> u32 #c_call;
    xkb_state_key_get_one_sym:        (state: *void, key: u32) -> u32 #c_call;
    xkb_state_key_get_utf8:           (state: *void, key: u32, buffer: *u8, size: u64) -> s32 #c_call;
    xkb_state_mod_name_is_active:     (state: *void, name: *u8, type: s32) -> s32 #c_call;
    xkb_compose_table_new_from_locale: (ctx: *void, locale: *u8, flags: s32) -> *void #c_call; @optional
    xkb_compose_state_new:            (table: *void, flags: s32) -> *void #c_call; @optional
    xkb_compose_state_feed:           (state: *void, keysym: u32) -> s32 #c_call; @optional
    xkb_compose_state_reset:          (state: *void) #c_call; @optional
    xkb_compose_state_get_status:     (state: *void) -> s32 #c_call; @optional
    xkb_compose_state_get_utf8:       (state: *void, buffer: *u8, size: u64) -> s32 #c_call; @optional
}
xkb: Xkbcommon;

XKB_KEYMAP_FORMAT_TEXT_V1 :: 1;
XKB_STATE_MODS_EFFECTIVE  :: 1 << 3;
XKB_COMPOSE_FEED_ACCEPTED :: 1;
XKB_COMPOSE_COMPOSING     :: 1;
XKB_COMPOSE_COMPOSED      :: 2;
XKB_COMPOSE_CANCELLED     :: 3;

// The protocols beyond the core: xdg-shell, xdg-decoration, fractional
// scaling, viewporter, cursor shapes, activation. Each message's signature
// is as wayland-scanner would write it (a leading number is the version
// that added it; "?" a nullable argument; "n" a new object, "o" an object,
// "u"/"i" integers, "f" fixed point, "s" a string, "a" an array, "h" a file
// descriptor), and lists the interfaces of its object arguments. Requests
// and events are in protocol order: that order is their opcode.

xdg_wm_base_interface:                    Wl_Interface;
xdg_surface_interface:                    Wl_Interface;
xdg_toplevel_interface:                   Wl_Interface;
zxdg_decoration_manager_v1_interface:     Wl_Interface;
zxdg_toplevel_decoration_v1_interface:    Wl_Interface;
wp_fractional_scale_manager_v1_interface: Wl_Interface;
wp_fractional_scale_v1_interface:         Wl_Interface;
wp_viewporter_interface:                  Wl_Interface;
wp_viewport_interface:                    Wl_Interface;
wp_cursor_shape_manager_v1_interface:     Wl_Interface;
wp_cursor_shape_device_v1_interface:      Wl_Interface;
xdg_activation_v1_interface:              Wl_Interface;

Msg :: struct {
    name:      string;
    signature: string;
    types:     [] *Wl_Interface;   // For each "o" and "n" argument, in order (null: any).
}

define_protocols :: () {
    surface_ := core.wl_surface_interface;
    seat_    := core.wl_seat_interface;
    output_  := core.wl_output_interface;
    pointer_ := core.wl_pointer_interface;

    define(*xdg_wm_base_interface, "xdg_wm_base", 6, .[
        .{"destroy", "", .[]},
        .{"create_positioner", "n", .[null]},
        .{"get_xdg_surface", "no", .[*xdg_surface_interface, surface_]},
        .{"pong", "u", .[]},
    ], .[
        .{"ping", "u", .[]},
    ]);
    define(*xdg_surface_interface, "xdg_surface", 6, .[
        .{"destroy", "", .[]},
        .{"get_toplevel", "n", .[*xdg_toplevel_interface]},
        .{"get_popup", "n?oo", .[null, *xdg_surface_interface, null]},
        .{"set_window_geometry", "iiii", .[]},
        .{"ack_configure", "u", .[]},
    ], .[
        .{"configure", "u", .[]},
    ]);
    define(*xdg_toplevel_interface, "xdg_toplevel", 6, .[
        .{"destroy", "", .[]},
        .{"set_parent", "?o", .[*xdg_toplevel_interface]},
        .{"set_title", "s", .[]},
        .{"set_app_id", "s", .[]},
        .{"show_window_menu", "ouii", .[seat_]},
        .{"move", "ou", .[seat_]},
        .{"resize", "ouu", .[seat_]},
        .{"set_max_size", "ii", .[]},
        .{"set_min_size", "ii", .[]},
        .{"set_maximized", "", .[]},
        .{"unset_maximized", "", .[]},
        .{"set_fullscreen", "?o", .[output_]},
        .{"unset_fullscreen", "", .[]},
        .{"set_minimized", "", .[]},
    ], .[
        .{"configure", "iia", .[]},
        .{"close", "", .[]},
        .{"configure_bounds", "4ii", .[]},
        .{"wm_capabilities", "5a", .[]},
    ]);
    define(*zxdg_decoration_manager_v1_interface, "zxdg_decoration_manager_v1", 1, .[
        .{"destroy", "", .[]},
        .{"get_toplevel_decoration", "no", .[*zxdg_toplevel_decoration_v1_interface, *xdg_toplevel_interface]},
    ], .[]);
    define(*zxdg_toplevel_decoration_v1_interface, "zxdg_toplevel_decoration_v1", 1, .[
        .{"destroy", "", .[]},
        .{"set_mode", "u", .[]},
        .{"unset_mode", "", .[]},
    ], .[
        .{"configure", "u", .[]},
    ]);
    define(*wp_fractional_scale_manager_v1_interface, "wp_fractional_scale_manager_v1", 1, .[
        .{"destroy", "", .[]},
        .{"get_fractional_scale", "no", .[*wp_fractional_scale_v1_interface, surface_]},
    ], .[]);
    define(*wp_fractional_scale_v1_interface, "wp_fractional_scale_v1", 1, .[
        .{"destroy", "", .[]},
    ], .[
        .{"preferred_scale", "u", .[]},
    ]);
    define(*wp_viewporter_interface, "wp_viewporter", 1, .[
        .{"destroy", "", .[]},
        .{"get_viewport", "no", .[*wp_viewport_interface, surface_]},
    ], .[]);
    define(*wp_viewport_interface, "wp_viewport", 1, .[
        .{"destroy", "", .[]},
        .{"set_source", "ffff", .[]},
        .{"set_destination", "ii", .[]},
    ], .[]);
    define(*wp_cursor_shape_manager_v1_interface, "wp_cursor_shape_manager_v1", 1, .[
        .{"destroy", "", .[]},
        .{"get_pointer", "no", .[*wp_cursor_shape_device_v1_interface, pointer_]},
        .{"get_tablet_tool_v2", "no", .[*wp_cursor_shape_device_v1_interface, null]},
    ], .[]);
    define(*wp_cursor_shape_device_v1_interface, "wp_cursor_shape_device_v1", 1, .[
        .{"destroy", "", .[]},
        .{"set_shape", "uu", .[]},
    ], .[]);
    define(*xdg_activation_v1_interface, "xdg_activation_v1", 1, .[
        .{"destroy", "", .[]},
        .{"get_activation_token", "n", .[null]},
        .{"activate", "so", .[surface_]},
    ], .[]);
}

// Fills in an interface. Its messages and their type lists live for the
// whole run: libwayland points at them.
define :: (iface: *Wl_Interface, name: string, version: s32, requests: [] Msg, events: [] Msg) {
    iface.name = name.data;   // Literals are zero-terminated.
    iface.version = version;
    iface.methods, iface.method_count = messages(requests);
    iface.events, iface.event_count = messages(events);
}

messages :: (list: [] Msg) -> *Wl_Message, s32 {
    if !list.count return null, 0;
    result := NewArray(list.count, Wl_Message);
    for list {
        m := *result[it_index];
        m.name = it.name.data;
        // An empty literal has no data at all; C wants a zero-terminated "".
        m.signature = ifx it.signature then it.signature.data else "\0".data;
        arguments := 0;
        for c: cast([] u8) it.signature if c >= #char "a" && c <= #char "z" arguments += 1;
        types := NewArray(max(arguments, 1), *Wl_Interface);
        argument, object := 0, 0;
        for c: cast([] u8) it.signature {
            if c < #char "a" || c > #char "z" continue;   // A version, or "?".
            if c == #char "o" || c == #char "n" {
                types[argument] = it.types[object];
                object += 1;
            }
            argument += 1;
        }
        m.types = types.data;
    }
    return result.data, xx list.count;
}

// Listeners: a procedure per event, in the protocol's order.

Wl_Registry_Listener :: struct {
    global:        (data: *void, registry: *void, name: u32, iface: *u8, version: u32) #c_call;
    global_remove: (data: *void, registry: *void, name: u32) #c_call;
}

Wl_Surface_Listener :: struct {
    enter:                      (data: *void, surface: *void, output: *void) #c_call;
    leave:                      (data: *void, surface: *void, output: *void) #c_call;
    preferred_buffer_scale:     (data: *void, surface: *void, factor: s32) #c_call;
    preferred_buffer_transform: (data: *void, surface: *void, transform: u32) #c_call;
}

Wl_Output_Listener :: struct {
    geometry:    (data: *void, output: *void, x: s32, y: s32, mm_w: s32, mm_h: s32, subpixel: s32, make: *u8, model: *u8, transform: s32) #c_call;
    mode:        (data: *void, output: *void, flags: u32, width: s32, height: s32, refresh: s32) #c_call;
    done:        (data: *void, output: *void) #c_call;
    scale:       (data: *void, output: *void, factor: s32) #c_call;
    name:        (data: *void, output: *void, name: *u8) #c_call;
    description: (data: *void, output: *void, description: *u8) #c_call;
}

Wl_Seat_Listener :: struct {
    capabilities: (data: *void, seat: *void, capabilities: u32) #c_call;
    name:         (data: *void, seat: *void, name: *u8) #c_call;
}

Wl_Pointer_Listener :: struct {
    enter:                   (data: *void, pointer: *void, serial: u32, surface: *void, sx: s32, sy: s32) #c_call;
    leave:                   (data: *void, pointer: *void, serial: u32, surface: *void) #c_call;
    motion:                  (data: *void, pointer: *void, time: u32, sx: s32, sy: s32) #c_call;
    button:                  (data: *void, pointer: *void, serial: u32, time: u32, button: u32, state: u32) #c_call;
    axis:                    (data: *void, pointer: *void, time: u32, axis: u32, value: s32) #c_call;
    frame:                   (data: *void, pointer: *void) #c_call;
    axis_source:             (data: *void, pointer: *void, source: u32) #c_call;
    axis_stop:               (data: *void, pointer: *void, time: u32, axis: u32) #c_call;
    axis_discrete:           (data: *void, pointer: *void, axis: u32, discrete: s32) #c_call;
    axis_value120:           (data: *void, pointer: *void, axis: u32, value120: s32) #c_call;
    axis_relative_direction: (data: *void, pointer: *void, axis: u32, direction: u32) #c_call;
}

Wl_Keyboard_Listener :: struct {
    keymap:      (data: *void, keyboard: *void, format: u32, fd: s32, size: u32) #c_call;
    enter:       (data: *void, keyboard: *void, serial: u32, surface: *void, keys: *Wl_Array) #c_call;
    leave:       (data: *void, keyboard: *void, serial: u32, surface: *void) #c_call;
    key:         (data: *void, keyboard: *void, serial: u32, time: u32, key: u32, state: u32) #c_call;
    modifiers:   (data: *void, keyboard: *void, serial: u32, depressed: u32, latched: u32, locked: u32, group: u32) #c_call;
    repeat_info: (data: *void, keyboard: *void, rate: s32, delay: s32) #c_call;
}

Wl_Data_Device_Listener :: struct {
    data_offer: (data: *void, device: *void, offer: *void) #c_call;
    enter:      (data: *void, device: *void, serial: u32, surface: *void, x: s32, y: s32, offer: *void) #c_call;
    leave:      (data: *void, device: *void) #c_call;
    motion:     (data: *void, device: *void, time: u32, x: s32, y: s32) #c_call;
    drop:       (data: *void, device: *void) #c_call;
    selection:  (data: *void, device: *void, offer: *void) #c_call;
}

Wl_Data_Offer_Listener :: struct {
    offer:          (data: *void, offer: *void, mime_type: *u8) #c_call;
    source_actions: (data: *void, offer: *void, actions: u32) #c_call;
    action:         (data: *void, offer: *void, action: u32) #c_call;
}

Wl_Data_Source_Listener :: struct {
    target:             (data: *void, source: *void, mime_type: *u8) #c_call;
    send:               (data: *void, source: *void, mime_type: *u8, fd: s32) #c_call;
    cancelled:          (data: *void, source: *void) #c_call;
    dnd_drop_performed: (data: *void, source: *void) #c_call;
    dnd_finished:       (data: *void, source: *void) #c_call;
    action:             (data: *void, source: *void, action: u32) #c_call;
}

Xdg_Wm_Base_Listener :: struct {
    ping: (data: *void, base: *void, serial: u32) #c_call;
}

Xdg_Surface_Listener :: struct {
    configure: (data: *void, surface: *void, serial: u32) #c_call;
}

Xdg_Toplevel_Listener :: struct {
    configure:        (data: *void, toplevel: *void, width: s32, height: s32, states: *Wl_Array) #c_call;
    close:            (data: *void, toplevel: *void) #c_call;
    configure_bounds: (data: *void, toplevel: *void, width: s32, height: s32) #c_call;
    wm_capabilities:  (data: *void, toplevel: *void, capabilities: *Wl_Array) #c_call;
}

Zxdg_Toplevel_Decoration_Listener :: struct {
    configure: (data: *void, decoration: *void, mode: u32) #c_call;
}

Wp_Fractional_Scale_Listener :: struct {
    preferred_scale: (data: *void, fractional_scale: *void, scale: u32) #c_call;
}

// Opcodes (a request's index in its interface) and enums.

WL_MARSHAL_FLAG_DESTROY :: 1;

WL_DISPLAY_GET_REGISTRY :: 1;
WL_REGISTRY_BIND :: 0;
WL_COMPOSITOR_CREATE_SURFACE :: 0;
WL_COMPOSITOR_CREATE_REGION  :: 1;
WL_SURFACE_DESTROY           :: 0;
